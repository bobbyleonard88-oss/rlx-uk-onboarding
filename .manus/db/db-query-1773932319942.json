  "query": "\n-- Get all sponsors and their total meeting counts vs max possible\nSELECT \n  s.companyName,\n  s.id as sponsorId,\n  COUNT(m.id) as total_meetings,\n  MAX(m.attendeeNumber) as max_attendees\nFROM sponsors s\nLEFT JOIN meetings m ON m.sponsorId = s.id AND m.isVisible = 1\nGROUP BY s.id, s.companyName\nORDER BY total_meetings ASC;\n",
