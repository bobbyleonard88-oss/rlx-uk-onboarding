  "query": "\nSELECT \n  m.sponsorId,\n  s.companyName,\n  m.attendeeNumber,\n  m.timeSlot,\n  COUNT(*) as meetingCount\nFROM meetings m\nLEFT JOIN sponsors s ON s.id = m.sponsorId\nWHERE m.status = 'suggested'\nGROUP BY m.sponsorId, m.attendeeNumber, m.timeSlot\nHAVING COUNT(*) > 1\nORDER BY meetingCount DESC\nLIMIT 20;\n",
