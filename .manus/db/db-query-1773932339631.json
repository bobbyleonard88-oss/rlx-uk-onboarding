  "query": "\n-- Get all booked slots for Appcast and Harver to find gaps\nSELECT s.companyName, m.timeSlot, m.attendeeNumber\nFROM meetings m\nJOIN sponsors s ON s.id = m.sponsorId\nWHERE s.companyName IN ('Appcast', 'Harver')\n  AND m.isVisible = 1\nORDER BY s.companyName, m.attendeeNumber, m.timeSlot;\n",
