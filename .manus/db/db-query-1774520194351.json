  "query": "SELECT dp.attendeeId, dp.firstName, dp.lastName, dp.company,\n  GROUP_CONCAT(m.timeSlot ORDER BY m.timeSlot) as bookedSlots,\n  COUNT(m.id) as meetingCount\nFROM delegateProfiles dp\nINNER JOIN meetings m ON m.attendeeId = dp.attendeeId AND m.status IN ('confirmed','suggested')\nGROUP BY dp.attendeeId, dp.firstName, dp.lastName, dp.company\nHAVING meetingCount > 0\nORDER BY dp.lastName;",
