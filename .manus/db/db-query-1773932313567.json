{
  "query": "\n-- For each sponsor, find which slots have 0 or 1 attendee booked (open for new meetings)\n-- First get total possible slots per sponsor (max 2 per slot)\nSELECT \n  s.companyName,\n  s.id as sponsorId,\n  m.timeSlot,\n  COUNT(*) as booked_count\nFROM meetings m\nJOIN sponsors s ON s.id = m.sponsorId\nWHERE m.isVisible = 1\nGROUP BY s.id, s.companyName, m.timeSlot\nHAVING COUNT(*) < 2\nORDER BY s.companyName, m.timeSlot;\n",
  "command": "mysql --batch --raw --column-names --default-character-set=utf8mb4 --host gateway02.us-east-1.prod.aws.tidbcloud.com --port 4000 --user 35vWS7AKWm9z2SD.36f32dd08149 --database AHKzVnYzSGv4NeXzoiv78q --execute \n-- For each sponsor, find which slots have 0 or 1 attendee booked (open for new meetings)\n-- First get total possible slots per sponsor (max 2 per slot)\nSELECT \n  s.companyName,\n  s.id as sponsorId,\n  m.timeSlot,\n  COUNT(*) as booked_count\nFROM meetings m\nJOIN sponsors s ON s.id = m.sponsorId\nWHERE m.isVisible = 1\nGROUP BY s.id, s.companyName, m.timeSlot\nHAVING COUNT(*) < 2\nORDER BY s.companyName, m.timeSlot;\n",
